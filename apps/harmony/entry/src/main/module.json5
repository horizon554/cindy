{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:microphone_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/EntryAbility.ets",
        "label": "$string:app_name",
        "icon": "$media:launcher",
        "startWindowIcon": "$media:login_hero",
        "startWindowBackground": "$color:brand_splash",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home",
              "action.system.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "cindycn",
                "host": "auth"
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.sendData",
              "ohos.want.action.sendMultipleData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.plain-text",
                "maxFileSupported": 20
              },
              {
                "scheme": "file",
                "utd": "general.image",
                "maxFileSupported": 20
              },
              {
                "scheme": "file",
                "utd": "general.file",
                "maxFileSupported": 20
              }
            ]
          }
        ],
        "launchType": "singleton"
      }
    ]
  }
}
